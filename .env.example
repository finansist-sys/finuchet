# Copy to .env on the server and fill in. NEVER commit .env (it is in .gitignore).
# Generate each random value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   (or: openssl rand -base64 48 | tr -d '/+=')

# Domain pointing to this server (A record). Used for HTTPS and the Mini App URL.
DOMAIN=finance.example.com

# From @BotFather. Rotate there with /revoke if it ever leaks.
BOT_TOKEN=

# Random values (letters, digits, - and _ only).
WEBHOOK_SECRET=
WEBHOOK_PATH_TOKEN=

# Random, 48+ chars. Turns Telegram IDs into anonymous hashes.
# Keep it ONLY here (not in backups of the database). If lost, users lose access to their data.
ID_PEPPER=

# Database passwords (random).
POSTGRES_DB=finuchet
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
