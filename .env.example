# Copy to .env and fill in. NEVER commit .env.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=prod                      # prod | dev  (dev enables fake initData — never on a server)
PUBLIC_URL=https://example.com # domain where Mini App + API are served

BOT_TOKEN=                    # from @BotFather
WEBHOOK_SECRET=               # random, 32+ chars, only [A-Za-z0-9_-]
WEBHOOK_PATH_TOKEN=           # random, makes webhook URL unguessable
ID_PEPPER=                    # random, 48+ chars. Keep separate from DB backups. Losing it = users lose access.

POSTGRES_DB=finuchet
POSTGRES_USER=finuchet
POSTGRES_PASSWORD=            # random
DATABASE_URL=postgresql+asyncpg://finuchet:CHANGE_ME@db:5432/finuchet
